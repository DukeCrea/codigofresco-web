# Variables de entorno del proyecto.
# En producción se configuran en Vercel (Project → Settings → Environment Variables).
# En local se copian a .env.local, que NUNCA se sube a git (ya está en .gitignore).

# ---------------------------------------------------------------------------
# Analítica (públicas: viajan al navegador)
# ---------------------------------------------------------------------------
# Al ser NEXT_PUBLIC_*, se incrustan durante el build: después de cambiarlas hay
# que volver a desplegar para que surtan efecto. Si están vacías no se carga
# ningún script de medición.

# Google Analytics 4. Formato G-XXXXXXXXXX (Administrar → Flujos de datos).
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity (mapas de calor y grabación de sesiones).
# Es el ID del proyecto en clarity.microsoft.com, no la etiqueta completa.
NEXT_PUBLIC_CLARITY_ID=

# ---------------------------------------------------------------------------
# Leads
# ---------------------------------------------------------------------------
# Base de datos donde vive el panel /panel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Aviso por correo de cada lead (resend.com). Es la red de seguridad: si la base
# está pausada, este correo es la única copia del contacto.
RESEND_API_KEY=
# Destinatario del aviso. Si se omite, se usa el correo de app/lib/site.ts,
# que desde el cambio de marca es hola@codigofresco.com.
# IMPORTANTE: mientras ese buzón no exista de verdad, hay que fijar aquí un
# correo que sí reciba (por ejemplo el Gmail personal). Si se deja vacío, cada
# lead se envía a una dirección inexistente y el aviso se pierde: es la única
# copia del contacto cuando la base está pausada.
LEADS_EMAIL_TO=
# Remitente. Requiere dominio verificado en Resend; si se omite se usa el
# remitente de pruebas onboarding@resend.dev.
LEADS_EMAIL_FROM=

# ---------------------------------------------------------------------------
# Panel de administración
# ---------------------------------------------------------------------------
# Contraseña de acceso a /panel. Si no está definida, el panel se bloquea solo.
# Antes del cambio de marca se llamaba DUKECREA_PANEL_PASSWORD; el código sigue
# aceptando ese nombre como respaldo para no dejar el panel bloqueado durante la
# migración, pero una vez creada la variable nueva conviene borrar la vieja.
CODIGOFRESCO_PANEL_PASSWORD=

# Secreto para firmar la sesión (aleatorio, largo). Generar con:
#   openssl rand -hex 32
SESSION_SECRET=

# Credenciales de admin: "usuario:saltHex:hashHex;usuario2:saltHex:hashHex"
# Se generan con deploy/gen-credential.mjs
PANEL_CREDENTIALS=

# Cloudflare Turnstile (opcional hasta configurarlo en el panel de Cloudflare).
# Site key es pública; el secret es privado.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
